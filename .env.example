# =============================================
# Planzo Environment Variables
# =============================================
# Copy this file to .env and fill in the values.

# --- Database ---
# Option A: Connection string (preferred for production / Vercel)
DATABASE_URL=postgresql://user:password@host:5432/planzo

# Option B: Individual connection params (for local dev)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=planzo
# DB_USER=postgres
# DB_PASSWORD=postgres

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string

# --- Frontend ---
# Set this for the frontend to know the API URL (only needed when backend is separate)
# VITE_API_URL=https://your-backend.vercel.app/api

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Node ---
NODE_ENV=development
PORT=4000

# --- Future Integrations ---
# GOOGLE_MAPS_KEY=your-google-maps-api-key
# STRIPE_SECRET_KEY=your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
